# Keep local SDK and generated build files out of the published archive.
.dart_tool/
.flutter-plugins-dependencies
.DS_Store
*.iml
.idea/
/build/
**/build/
/pubspec.lock

# Keep the example source while excluding its generated platform project files.
example/.dart_tool/
example/.flutter-plugins-dependencies
example/pubspec.lock
example/build/
example/ios/**/Pods/
example/ios/**/.symlinks/
example/ios/**/DerivedData/
example/ios/**/xcuserdata/
example/ios/Flutter/Generated.xcconfig
example/ios/Flutter/flutter_export_environment.sh
example/ios/Flutter/ephemeral/
example/ios/Flutter/App.framework/
example/ios/Flutter/Flutter.framework/
example/ios/Flutter/Flutter.podspec
example/ios/Flutter/flutter_assets/
example/ios/Flutter/app.flx
example/ios/Flutter/app.zip
example/ios/Podfile.lock
example/ios/ServiceDefinitions.json
example/lib/demo/
example/test/
example/integration_test/

# The screen recording is a local development artifact, not package content.
assets/*.mov
